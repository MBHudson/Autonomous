# Runtime data and secrets - never commit these.
storage/config.json
storage/state.json
storage/exec.log
storage/mcp.log
storage/exec-approvals.json
storage/sessions/*.json
# Generated by the launchers (start.bat / start.sh) for this machine's PHP.
storage/php-runtime.ini

# Allow the sessions folder to exist without its contents.
!storage/sessions/.gitkeep

# Agent sandbox working files.
sandbox/*
!sandbox/.gitkeep

# Local-only files
.htpasswd

# Editor / OS junk
.idea/
.vscode/
.DS_Store
Thumbs.db
*.tmp
*.log
