# Runtime data and secrets - never commit these.
storage/config.json
storage/state.json
storage/exec.log
storage/mcp.log
storage/exec-approvals.json
storage/sessions/*.json
# Generated by the launchers (start.bat / start.sh) for this machine's PHP.
storage/php-runtime.ini

# Built-in browser: created at runtime by src/Browser.php. Holds cookies and a
# login session, so it must NEVER be committed.
storage/browser-profile/
storage/browser.json

# Allow the sessions folder to exist without its contents.
!storage/sessions/.gitkeep

# Agent sandbox working files.
sandbox/*
!sandbox/.gitkeep

# Local-only files
.htpasswd

# A second copy of the app kept for reference or comparison (a clean copy, an
# archive of an older version). Each carries its own storage/ with the same
# token and keys, and it is not part of the app -- never commit one.
cleancopy/
the-copy-before-the-huge-ui-change/

# A packaged copy of the whole app (220 MB of the same files).
Autonomous.zip

# Backups of anything tracked, storage/config.json included: a `config.json.bak`
# holds the access token and every API key in clear, and the ignore rule above
# only covers the exact name.
*.bak

# The update feature's own working folder: the downloaded archive, the staging
# copy, the diff and the cached check answer. All runtime data, all re-creatable.
storage/updates/

# Working notes: findings, hand-offs, session journals. The README is the
# documentation -- these are scratch, and while a cleanup is in progress they
# quote keys, tokens and account addresses that must not be published. Add a
# name here when you start one. `git check-ignore -v <file>` says which rule
# caught a file, so nothing has to be guessed.
/STATUS.md
/README-HANDOVER.md
/scratch/

# Screenshots ARE tracked -- the README embeds them by path. A capture that
# shows a BUG rather than the fixed surface misrepresents the app, so it is
# scratch too: name it here (and keep the fixed one, which is published).
/screenshots/deny-undo-panel.png

# Editor / OS junk
.idea/
.vscode/
.DS_Store
Thumbs.db
*.tmp
*.log

.fake