# Pre-commit: run both suites in a FRESH COPY of the tree being committed, so a
# commit cannot go out with a suite that only passes in this checkout.
#
# `--index` is deliberate: the copy is the staged snapshot, which is what the
# commit will contain. Checking the working tree instead would test a half-staged
# commit as if it were whole.
#
# It takes about 17 seconds, which is what the check costs: 16.8-17.5s measured
# over six runs on a warm machine. An earlier note here said "about two
# minutes", which is seven times the price and enough to make a reader turn the
# hook off; it then said 40 seconds, which was true until the PHP suite started
# running its files at the same time -- that work was real, it was just being
# waited on one file at a time. A cold machine, or a virus scanner reading 281
# fresh files, is slower -- the copy is real work, not a delay. `git commit
# --no-verify` skips it once; the copy is kept when a suite fails, so the failure
# can be looked at where it happened.
#
# None of those figures has to be taken on trust: this hook prints how long its
# own run took, and the check it calls prints a phase breakdown as well, so the
# number above is re-measured by every commit instead of remembered. A quoted
# cost that nobody re-measures drifts -- this one had drifted by 3x.
#
# Enable it in a clone (it is not automatic -- nothing in a repo can install a
# hook into someone's .git):
#
#     git config core.hooksPath .githooks
#
# Turn it off again with:
#
#     git config --unset core.hooksPath
#
# Needs php; set FRESH_CHECK_PHP=/path/to/php if it is not on PATH.
#
# When this file is first added to git, add it EXECUTABLE, or a fresh clone gets
# a hook git skips ("hook was ignored because it is not set as executable"):
#
#     git add --chmod=+x .githooks/pre-commit

set -u

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    # Not in a work tree (a bare repo, or a stray invocation): nothing to check.
    exit 0
}
cd "$root" || exit 1

if [ ! -f tests/freshClone.php ]; then
    # An older clone with core.hooksPath pointed here. Say so and stay out of the
    # way rather than blocking every commit in it.
    echo "pre-commit: tests/freshClone.php is not in this tree, so there is nothing to run" >&2
    exit 0
fi

php_bin="${FRESH_CHECK_PHP:-}"
if [ -z "$php_bin" ]; then
    if command -v php >/dev/null 2>&1; then
        php_bin=php
    elif [ -x /c/xampp/php/php.exe ]; then
        php_bin=/c/xampp/php/php.exe
    fi
fi

if [ -z "$php_bin" ]; then
    echo "pre-commit: no php found, so the suites cannot run." >&2
    echo "  Put php on PATH, or set FRESH_CHECK_PHP to it, then commit again." >&2
    echo "  (git commit --no-verify skips this check.)" >&2
    exit 1
fi

echo "pre-commit: both suites, in a fresh copy of the staged tree"
echo "            about 17 seconds -- git commit --no-verify skips this"
echo ""

# Timed so the printed figure is the measured one, not the estimate above. Kept
# in plain `date +%s` seconds with no external tool, and if a host's date will
# not produce a number the line is simply omitted -- a missing duration must not
# be the thing that blocks a commit.
started=$(date +%s 2>/dev/null)
case "${started:-}" in
    ''|*[!0-9]*) timed=0 ;;
    *)           timed=1 ;;
esac

"$php_bin" tests/freshClone.php --index
check_status=$?

elapsed=""
if [ "$timed" = "1" ]; then
    finished=$(date +%s 2>/dev/null)
    case "${finished:-}" in
        ''|*[!0-9]*) ;;
        *)           elapsed=$((finished - started)) ;;
    esac
fi

if [ "$check_status" -ne 0 ]; then
    echo "" >&2
    echo "pre-commit: the suites do not pass on the tree you are committing." >&2
    if [ -n "$elapsed" ]; then
        echo "  It ran for ${elapsed}s. The fresh copy is kept where the output above says, so" >&2
    else
        echo "  The fresh copy is kept where the output above says, so the failure can be" >&2
    fi
    echo "  looked at in place. Bypass this once with: git commit --no-verify" >&2
    exit 1
fi

if [ -n "$elapsed" ]; then
    echo "pre-commit: the suites passed in ${elapsed}s -- this commit is going out verified"
fi

exit 0
