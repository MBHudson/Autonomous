# Router .htaccess - Enable routing for the router module

RewriteEngine On

# Refuse runtime data and dev tooling at ANY depth, not only directly under the
# app root. storage/ holds the token and every API key, and tests/ is dev code --
# each folder ships its own .htaccess, which only ever governs itself. A second
# copy of the app kept inside the web root (a backup, an archived version) brings
# its own storage/ and tests/, and its tests/ may have been made before
# tests/.htaccess existed -- so those files were served in full, PHP source
# included. serve.php and nginx.example.conf refuse these names as any path
# segment; this is the same rule for Apache.
#
# The pattern is anchored on the segment boundaries, so /testsuite/ and
# /ui/js/tests.js are NOT caught -- only a folder actually named tests. API routes
# are exempt: /api/sessions is the session LIST, not the storage folder, and
# matching it broke the sidebar. No API route maps onto a path from disk.
#
# mod_rewrite is NOT enough on its own here. In per-directory context a child
# .htaccess replaces its parent's rewrite rules unless it opts into
# `RewriteOptions Inherit`, and a copy of this app ships its own root .htaccess --
# so the rule above never sees `<copy>/tests/...`. (Verified with a rewrite trace:
# the root rules are skipped entirely once the request maps into the copy.)
#
# mod_alias config IS merged normally, so `RedirectMatch 403` holds no matter what
# a nested folder declares. It takes the full URL-path, which is exactly what this
# needs, and has been in Apache since 1.3 -- unlike <If>, which only became legal
# in .htaccess in later 2.4 releases. The <IfModule> wrapper only means a host
# without mod_alias skips this rule instead of failing to parse the file.
RewriteRule (^|/)(storage|logs|tmp|sessions|tests)(/|$) - [F,L,NC]

# The app root is a git checkout, so .git/ sits INSIDE the web root: it holds
# the whole history and the remote config, and Apache serves any file it can
# read. `.git/config` alone can carry a credentialed URL, and `.git/objects`
# reconstructs every file ever committed -- including one that was removed
# later for being a secret. This is the same class of leak as storage/, so it
# gets the same rule: refuse any path whose SEGMENT starts with a dot, at any
# depth, which also covers a `.git` inside a second copy of the app.
#
# `.well-known` stays reachable: it is the ACME / Let's Encrypt challenge folder
# and refusing it breaks certificate renewal. It is matched by name, not by the
# leading dot.
#
# Both layers, for the reason described above: mod_rewrite alone is skipped once
# a nested folder supplies its own .htaccess, and mod_alias alone is absent on a
# host that does not load it.
RewriteRule (^|/)\.(?!well-known) - [F,L,NC]
<IfModule mod_alias.c>
    RedirectMatch 403 (?i)^/(?!(?:.*/)?api/)(?:.*/)?(?:storage|logs|tmp|sessions|tests)(?:/|$)
    RedirectMatch 403 (?i)/(?:.*/)?\.(?!well-known)
</IfModule>

# Never cache HTML entry points (JS/CSS already carry ?v= cache busters)
<FilesMatch "index\.html$">
    Header set Cache-Control "no-store, no-cache, must-revalidate"
</FilesMatch>

# Redirect everything to index.php except existing files/directories
# (never intercept API calls — api/ has its own front controller)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !/api/ [NC]
RewriteRule ^(.*)$ public/index.php [L]


# --- CORS: deliberately NOT enabled ---
# This used to set `Access-Control-Allow-Origin: *`, which let any website on
# the internet fetch this server and READ the response: every agent's
# conversations, memory and config. The UI is served from this same origin and
# never needed it. Removing it is the fix.
#
# If a separate front end ever needs to call this, set an explicit allowlist in
# env instead: ROUTER_CORS_ORIGINS=https://your.other.host

# Revalidate JS/CSS on every load.
#
# These files were served with no Cache-Control at all, so the browser applied
# heuristic freshness and happily reused a month-old module after a deploy.
# That is how the browser ended up running an old api.js (no .sandbox method)
# against a new tools.js that called it. "no-cache" does NOT mean "don't cache"
# -- it means revalidate first, which costs a cheap 304 and guarantees the
# browser never pairs a new module with an old one.
<FilesMatch "\.(js|css)$">
    Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# Cache control for API responses
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType application/json "access plus 0 minutes"
</IfModule>

# Security headers
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "DENY"
Header set X-XSS-Protection "1; mode=block"